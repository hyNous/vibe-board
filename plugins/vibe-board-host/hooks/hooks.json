{
  "description": "Start Vibe Board when a Codex session starts and bind Codex as the primary usage host.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/host-hook.mjs\" --source codex --host codex",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/host-hook.mjs\" --source codex --host codex",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
