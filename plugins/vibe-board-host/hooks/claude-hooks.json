{
  "description": "Start Vibe Board when a Claude Code session starts and bind Claude Code as the primary usage host.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/host-hook.mjs\" --source claude-code --host claude-code",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
