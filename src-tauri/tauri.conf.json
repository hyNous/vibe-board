{
  "$schema": "https://raw.githubusercontent.com/nicedoctor/tauri-config-schema/v2/schema.json",
  "productName": "Vibe Board",
  "identifier": "com.vibeboard.desktop",
  "version": "3.1.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1423",
    "beforeDevCommand": "pnpm build:bridge && pnpm dev",
    "beforeBuildCommand": "pnpm build:bridge:release && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "Vibe Board",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 420,
        "height": 52,
        "x": null,
        "y": 0,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/themes/**",
          "$HOME/.vibeboard/themes/**",
          "$HOME/.agent-island/themes/**",
          "$HOME/.codex/pets/**",
          "$HOME/.config/vibeboard/themes/**",
          "$HOME/.config/agent-island/themes/**",
          "$HOME/.config/agentbro/themes/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/themes": "themes",
      "target/vibe-board-bridge-resource/vibe-board-bridge": "vibe-board-bridge"
    }
  }
}
