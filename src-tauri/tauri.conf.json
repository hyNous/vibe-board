{
  "$schema": "https://raw.githubusercontent.com/nicedoctor/tauri-config-schema/v2/schema.json",
  "productName": "Vibe Board",
  "identifier": "com.agentisland.desktop",
  "version": "3.1.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1423",
    "beforeDevCommand": "pnpm build:bridge && pnpm dev",
    "beforeBuildCommand": "pnpm build:bridge:release && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "Vibe Board",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 420,
        "height": 52,
        "x": null,
        "y": 0,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/pets/**",
          "$RESOURCE/themes/**",
          "$HOME/.agent-island/pets/**",
          "$HOME/.agent-island/themes/**",
          "$HOME/.agentbro/pets/**",
          "$HOME/.codex/pets/**",
          "$HOME/.config/agent-island/themes/**",
          "$HOME/.config/agentbro/themes/**",
          "$APPCACHE/pet-asar-cache/**",
          "/Applications/Codex.app/Contents/Resources/webview/assets/**",
          "$HOME/Applications/Codex.app/Contents/Resources/webview/assets/**",
          "$LOCALDATA/OpenAI/Codex/app/resources/webview/assets/**",
          "$LOCALDATA/Programs/Codex/resources/webview/assets/**",
          "$LOCALDATA/Programs/Codex/app/resources/webview/assets/**",
          "C:/Program Files/WindowsApps/OpenAI.Codex_*/app/resources/webview/assets/**",
          "C:/Program Files/WindowsApps/OpenAI.Codex_*/resources/webview/assets/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentisland",
          "ccswitch"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/pets": "pets",
      "../src/themes": "themes",
      "target/agent-island-bridge-resource/agent-island-bridge": "agent-island-bridge"
    }
  }
}
