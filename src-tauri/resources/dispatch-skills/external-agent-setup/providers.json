{
  "schema_version": 1,
  "providers": {
    "opencode": {
      "command": "opencode",
      "command_env": "OPENCODE_BIN",
      "command_candidates": [
        "${APPDATA}/npm/opencode.exe",
        "${APPDATA}/npm/node_modules/opencode-ai/bin/opencode.exe",
        "${APPDATA}/npm/opencode.cmd",
        "${LOCALAPPDATA}/opencode/bin/opencode.exe",
        "${USERPROFILE}/.opencode/bin/opencode.exe"
      ],
      "args": ["run", "--format", "json", "--agent", "codex-worker"],
      "prompt_transport": "argv_end",
      "cwd_flag": "--dir",
      "model_flag": "--model",
      "effort_flag": "--variant",
      "default_model": "opencode-go/deepseek-v4-flash",
      "check_args": ["--version"],
      "output_parser": "opencode-jsonl",
      "quota_check": {
        "safe": true,
        "kind": "http_json",
        "url": "https://opencode.ai/zen/go/v1/usage",
        "timeout_ms": 10000,
        "credential_file_candidates": [
          "${USERPROFILE}/.local/share/opencode/auth.json",
          "${HOME}/.local/share/opencode/auth.json",
          "${LOCALAPPDATA}/opencode/auth.json"
        ],
        "credential_keys": ["opencode-go", "opencode-go-api", "opencode-go-api-key"]
      }
    },
    "antigravity": {
      "command": "agy",
      "command_env": "AGY_BIN",
      "command_candidates": [
        "${LOCALAPPDATA}/agy/bin/agy.exe",
        "${USERPROFILE}/.agy/bin/agy.exe"
      ],
      "args": ["--input-format", "stream-json", "--output-format", "stream-json"],
      "permission_args": ["--dangerously-skip-permissions"],
      "prompt_transport": "stdin_json",
      "stdin_template": { "event": "user", "message": { "content": "$PROMPT" } },
      "model_flag": "--model",
      "effort_flag": "--effort",
      "session_flag": "--conversation",
      "output_parser": "result-event",
      "preserve_response_on_nonzero": true,
      "check_args": ["--version"],
      "quota_check": {
        "safe": true,
        "timeout_ms": 10000,
        "args": ["-p", "/usage"],
        "available_patterns": ["(?:remaining|left|available)[^\\r\\n]*(?:[1-9]\\d*|unlimited|true)"],
        "unavailable_patterns": ["(?:no|zero|0)\\s*(?:quota|credits?)", "(?:quota|credits?)[^\\r\\n]*(?:exhausted|depleted|unavailable|limit reached)"]
      }
    }
  }
}
